# ID of the Google Sheet (from its URL).
SPREADSHEET_ID=
# Sheet tab name. Empty = first sheet.
SHEET_NAME=
# Path to service-account JSON key file.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Alternative: base64-encoded service-account JSON (takes precedence over the file).
# Generate with: base64 -i credentials.json | tr -d '\n'
# GOOGLE_CREDENTIALS_JSON=<base64>
PORT=8080
REFRESH_INTERVAL_SECONDS=60
# Appsistència (https://xiquetsdelserrallo.appsistencia.cat). Optional;
# login only attempted when both user and password are set.
# APPSISTENCIA_URL=https://xiquetsdelserrallo.appsistencia.cat
# APPSISTENCIA_USER=
# APPSISTENCIA_PASSWORD=
